      "schedule_end_mon": "22:30:00",
      "schedule_start_mon": "06:00:00",
      "schedule_start_tue": "06:00:00",
      "schedule_end_tue": "22:30:00",
      "schedule_start_wed": "06:00:00",
      "schedule_end_wed": "22:30:00",
      "schedule_start_thu": "06:00:00",
      "schedule_end_thu": "22:30:00",
      "schedule_start_fri": "06:00:00",
      "schedule_end_fri": "22:30:00",
      "schedule_start_sat": "06:00:00",
      "schedule_end_sat": "22:30:00",
      "schedule_start_sun": "06:00:00",
      "schedule_end_sun": "22:30:00",
      "vacation_toggle": "input_boolean.vacation_mode",
